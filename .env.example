# ── PostgreSQL ──────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=chatbot

# ── Application ─────
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-a-long-random-string

# ── LLM Provider ───
# Options: anthropic | openai | ollama
#
# Anthropic examples:
#   LLM_PROVIDER=anthropic
#   LLM_MODEL=claude-opus-4-8
#
# OpenAI examples:
#   LLM_PROVIDER=openai
#   LLM_MODEL=gpt-4o
#
# Local ollama examples (no API key needed):
#   LLM_PROVIDER=ollama
#   LLM_MODEL=phi3:mini
#   LLM_MODEL=gemma3:1b
#
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-4-8

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Base URL for ollama (only used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# ── Embeddings ──────
# Options: ollama | openai
#
# Local ollama examples (no API key needed):
#   EMBEDDING_PROVIDER=ollama
#   EMBEDDING_MODEL=nomic-embed-text
#
# OpenAI examples:
#   EMBEDDING_PROVIDER=openai
#   EMBEDDING_MODEL=text-embedding-3-small
#
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# ── RAG / Chunking ──
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_CHUNKS_FOR_RAG=5
MAX_FILE_SIZE_MB=80

# ── Admin Account (created on first startup if no admin exists) ───────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123456
